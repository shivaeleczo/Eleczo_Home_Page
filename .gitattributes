# Normalise line endings so Windows and CI agree.
* text=auto eol=lf

# Shell scripts must stay LF or they break on Linux runners.
*.sh text eol=lf
*.mjs text eol=lf
*.yml text eol=lf

# Windows-only tooling keeps CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binaries.
*.png binary
*.jpg binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
